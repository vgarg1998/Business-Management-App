<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/search_text_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10px"
        android:layout_marginRight="10px"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="10px"
        app:cardCornerRadius="80px"

        android:elevation="-15px"
        >
        <TextView
            android:id="@+id/search_text"
            android:layout_width="match_parent"
            android:layout_marginLeft="10px"
            android:layout_marginRight="10px"
            android:gravity="center"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="10px"
            android:layout_marginBottom="10px"
            android:layout_height="150px"
            android:text="Search..."
            android:elevation="5px"
         />

    </androidx.cardview.widget.CardView>



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/manage_customer_recycler_view"
        android:layout_width="match_parent"
        android:layout_marginTop="10px"
        android:layout_marginRight="10px"
        android:layout_marginLeft="10px"
        android:layout_marginBottom="10px"
        android:layout_height="0px"
        app:layout_constraintTop_toBottomOf="@id/search_text_card_view"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>