<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Order ID Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/order_id_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order ID:"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/order_id_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12345"
                android:layout_marginStart="8dp"
                android:textColor="@android:color/holo_blue_dark"
                android:textSize="16sp"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Customer Name -->
        <TextView
            android:id="@+id/customer_name_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customer Name"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingVertical="4dp"
            android:gravity="center" />

        <!-- Product Name -->
        <TextView
            android:id="@+id/product_name_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Product Name"
            android:textSize="16sp"
            android:paddingVertical="4dp"
            android:gravity="center" />

        <!-- Grid 1: Order Date and Proposed End Date -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:rowCount="2"
            android:columnCount="2"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="ORDER DATE"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_columnWeight="1" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="PROPOSED END DATE"
                android:textStyle="bold"
                android:layout_columnWeight="1"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/text_view_order_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="01-Jan-2024"
                android:layout_columnWeight="1"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/text_view_proposed_end_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="15-Jan-2024"
                android:layout_columnWeight="1"
                android:textAlignment="center" />
        </GridLayout>

        <!-- Grid 2: Quantity Ordered and Quantity Acquired -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:rowCount="2"
            android:columnCount="2"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="QUANTITY ORDERED(Kg)"
                android:textStyle="bold"
                android:layout_columnWeight="1"
                android:textAlignment="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="QUANTITY ACQUIRED(Kg)"
                android:textStyle="bold"
                android:layout_columnWeight="1"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/text_view_ordered_quantity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="10"
                android:layout_columnWeight="1"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/text_view_order_acquired"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="8"
                android:layout_columnWeight="1"
                android:textAlignment="center" />
        </GridLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
