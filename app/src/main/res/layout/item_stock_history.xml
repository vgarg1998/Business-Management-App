<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/label_product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product Name:"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/text_view_product_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/label_product_name"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/label_product_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product ID:"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/label_product_name"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/text_view_product_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/text_view_product_name"
            app:layout_constraintStart_toEndOf="@id/label_product_id"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/label_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantity:"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/label_product_id"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/text_view_quantity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/text_view_product_id"
            app:layout_constraintStart_toEndOf="@id/label_quantity"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/label_number_of_bags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Number of Bags:"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/label_quantity"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/text_view_number_of_bags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/text_view_quantity"
            app:layout_constraintStart_toEndOf="@id/label_number_of_bags"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/label_added_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Added Date:"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/label_number_of_bags"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/text_view_added_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/text_view_number_of_bags"
            app:layout_constraintStart_toEndOf="@id/label_added_date"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/delete_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/text_view_added_date"
            android:text="Delete" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>